    "<div align=\"center\">\n",
    "  <h3>UNIVERSIDAD CENTRAL DE VENEZUELA</h3>\n",
    "  <p>FACULTAD DE CIENCIAS ECONÓMICAS Y SOCIALES<br>\n",
    "  ESCUELA DE ESTADÍSTICA Y CIENCIAS ACTUARIALES<br>\n",
